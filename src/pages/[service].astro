---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import WikiLayout from '../layouts/WikiLayout.astro';
import { services, serviceByName } from '../data/services';

export async function getStaticPaths() {
  return services.map(s => ({ params: { service: s.name } }));
}

const { service } = Astro.params;
const svc = serviceByName.get(service ?? '');

// Read pre-generated wiki HTML at build time
const htmlPath = join(process.cwd(), 'wiki-src', service ?? '', 'index.html');
let endpointHtml = '';
let inlineStyles = '';
let endpointCount = 0;
let jsonLdScripts: Record<string, any>[] = [];

try {
  const html = readFileSync(htmlPath, 'utf-8');

  const styleMatch = html.match(/<style>([\s\S]*?)<\/style>/);
  if (styleMatch) inlineStyles = styleMatch[1];

  // Extract only the <main> content (pre-generated HTML may use bare <main> or <main class="...">)
  const mainMatch = html.match(/<main[^>]*>([\s\S]*?)<\/main>/);
  if (mainMatch) {
    endpointHtml = mainMatch[1];
  } else {
    const bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/);
    if (bodyMatch) endpointHtml = bodyMatch[1];
  }

  // Count unique endpoint detail links; an endpoint may repeat across tag sections.
  const detailLinks = endpointHtml.match(/href="\/[^"]+\/[A-Z]+-[^"]*"/g) ?? [];
  endpointCount = new Set(detailLinks).size;

  const jsonLdRe = /<script type="application\/ld\+json">([\s\S]*?)<\/script>/g;
  let m;
  while ((m = jsonLdRe.exec(html)) !== null) {
    try { jsonLdScripts.push(JSON.parse(m[1])); } catch {}
  }
} catch {
  endpointHtml = '<p class="text-sm text-neutral-400 py-24 text-center">端点尚未收录。请运行 sync-wiki-zh.py 生成文档内容。</p>';
}

const pageTitle = svc ? `${svc.title}（${svc.name}）API 文档 — Autional` : `${service} API 文档 — Autional`;
const description = svc
  ? `${svc.title}（${svc.name}）API 参考：共 ${endpointCount} 个端点，含请求参数、请求体与响应结构说明。服务端口 ${svc.port}。`
  : `Autional ${service} 服务的 API 端点文档。`;
---

<WikiLayout title={pageTitle} description={description} jsonLd={jsonLdScripts}>
  <div class="flex-1 overflow-y-auto bg-neutral-50/50">
    <div class="sticky top-0 bg-white/95 backdrop-blur border-b border-primary-100/50 px-4 py-3 z-10">
      <div class="flex items-center justify-between">
        <span class="text-sm font-semibold text-primary-900 truncate">{svc?.title ?? service}</span>
        <span class="text-[0.65rem] font-mono font-medium text-primary-400 shrink-0">{endpointCount} 个端点</span>
      </div>
    </div>
    <div class="wiki-content px-4 md:px-8 py-10 max-w-4xl">
      {inlineStyles && <style set:html={inlineStyles} />}
      <div set:html={endpointHtml} />
    </div>
  </div>
</WikiLayout>
