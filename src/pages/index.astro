---
import WikiLayout from '../layouts/WikiLayout.astro';
import { services } from '../data/services';
---

<WikiLayout title="API 知识库 — Autional" description="覆盖全部 27 个 Autional 微服务的端点文档，可浏览 1400+ API 端点规格与请求/响应结构。">
  <div class="flex-1 overflow-y-auto">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-10">
      <div class="mb-10">
        <h1 class="text-3xl font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-900">API 知识库</h1>
        <p class="mt-2 text-base text-neutral-500 leading-relaxed max-w-lg">
          覆盖全部 {services.length} 个微服务的端点文档。选择一个服务即可浏览其 API 参考。
        </p>
        <div class="mt-4 flex items-center gap-2 flex-wrap">
          <span class="brand-kicker">OpenAPI 3.0</span>
          <span class="text-xs text-neutral-400 font-mono">{services.length} 个服务</span>
        </div>
      </div>

      <!-- 服务卡片网格 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {services.map(s => (
          <a href={`/${s.name}/`} class="group block rounded-2xl border border-primary-100/80 bg-white p-5 transition hover:border-primary-300 hover:shadow-card hover:-translate-y-0.5 no-underline">
            <div class="flex items-start justify-between">
              <h2 class="text-sm font-semibold text-primary-900 group-hover:text-primary-700 transition">{s.title}</h2>
              <span class="text-[0.65rem] font-mono text-primary-400 shrink-0 mt-0.5">:{s.port}</span>
            </div>
            <div class="mt-3 flex items-center gap-2">
              <span class="text-[0.7rem] font-medium text-primary-500">浏览端点 &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</WikiLayout>
