---
import WikiLayout from '../layouts/WikiLayout.astro';
const links = [
  ['API 知识库首页', '/', '浏览全部 27 个微服务的端点文档入口。'],
  ['身份服务', '/identity-service/', '登录、注册、MFA 与身份管理的全部端点。'],
  ['租户服务', '/tenant-service/', '租户、成员与应用管理的全部端点。'],
  ['审计服务', '/audit-service/', '审计日志、异常检测与 SIEM 对接的全部端点。'],
];
---

<WikiLayout
  title="页面未找到 — Autional API 知识库"
  description="你访问的页面不存在或已被移动。请从站内入口继续浏览其他 API 文档。"
  noindex
>
  <div class="flex-1 overflow-y-auto">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-10">
      <span class="brand-kicker">404</span>
      <h1 class="mt-5 text-3xl font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-900">页面未找到</h1>
      <p class="mt-3 text-base text-neutral-500 leading-relaxed max-w-lg">
        你访问的页面不存在或已被移动。请检查链接是否正确，或从下方入口继续浏览；也可以通过导航菜单访问其他 API 文档。
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
        {links.map(([label, href, description]) => (
          <a href={href} class="group block rounded-md border border-primary-100/80 bg-white p-5 transition hover:border-primary-300 hover:shadow-card hover:-translate-y-0.5 no-underline">
            <div class="text-sm font-semibold text-primary-900 group-hover:text-primary-700 transition">{label}</div>
            <p class="mt-2 text-[0.8rem] leading-relaxed text-neutral-500">{description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</WikiLayout>
